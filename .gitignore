*.launch

# Editor files
*.swp
*.swo
*~
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary and backup files
*.bak
*.tmp
*.orig
*.rej

# Keep STM32CubeIDE project configuration and source files.
# Do NOT ignore:
#   .project
#   .cproject
#   .mxproject
#   .settings/
#   *.ioc
#   *.ld
#   Core/
#   Drivers/
#   Middlewares/
#   USB_HOST/
